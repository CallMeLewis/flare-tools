{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flare Tools",
  "version": "../package.json",
  "identifier": "com.darkzone.flaretools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flare Tools",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2QzhFRkZEOTA3NjQ1Q0EKUldUS1JYYVEvZS9JRmdLMU1aQm5mcko5ZHdna2xnZkk1TDZ3WVBSS2gwUHllTnFjcHNqRFI2TW8K",
      "endpoints": [
        "https://updates.darkzone.dev/flare-tools/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "steam_api64.dll": "steam_api64.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
